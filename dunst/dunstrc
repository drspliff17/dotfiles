[global]
    monitor = 1
    follow = none
    corner_radius = 10

    origin = top-center
    frame_color = "#5B6DA6"
    separator_color = "#56649A"

[center_text]
    appname = "center-text"
    alignment = center

[urgency_low]
    background = "#56649A"
    foreground = "#c7c6cb"

[urgency_normal]
    background = "#676B98"
    foreground = "#c7c6cb"

[urgency_critical]
    background = "#676B98"
    foreground = "#c7c6cb"
