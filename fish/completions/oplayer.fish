# Generated by oplayer completions fish; edit the Odin tables, not this file.
function __oplayer_context
    set -l words (commandline -opc)
    set -l state root
    set -l allow_path yes
    for word in $words[2..-1]
        switch $state
            case root
                switch $word
                    case --
                        set state literal
                case '--help' '-h' 'help'
                    set state none
                case '--command' '-c' 'cmd'
                    set state command
                case '--mode' '-m' 'mode'
                    set state option-mode
                case '--library' '-l'
                    set state option-path
                case '--artist' '-a'
                    set state option-path
                case '--shuffle-all' '--shuffle'
                    set allow_path no
                case '--headless'
                case '--no-library'
                case 'completions' '--completions'
                    set state shell
                    case '*'
                        set allow_path no
                end
            case command
                switch $word
                case 'play' 'p'
                    set state none
                case 'pause' 'pa'
                    set state none
                case 'stop' 'st'
                    set state none
                case 'next' 'n'
                    set state none
                case 'previous' 'prev'
                    set state none
                case 'mode' 'm'
                    set state ipc-mode
                case 'open' 'o'
                    set state ipc-path
                case 'volume' 'v' 'vol'
                    set state setting
                case 'speed' 's'
                    set state setting
                case 'seek' 'sk'
                    set state none
                case 'loop' 'l'
                    set state loop
                case 'count' 'ct'
                    set state none
                case 'status' 'stat'
                    set state none
                case 'reload-config' 'rc'
                    set state none
                case 'quit' 'q'
                    set state none
                case 'help' 'h' '-h' '--help'
                    set state none
                    case '*'
                        set state none
                end
            case option-mode ipc-mode
                set -l previous $state
                set state none
                switch $word
                case 'ordered' 'o'
                    set allow_path yes
                    if test $previous = ipc-mode
                        set state ipc-path
                    end
                    if test $previous = option-mode
                        set state root
                    end
                case 'shuffle' 's' 'shuffle-all'
                    set allow_path no
                    if test $previous = option-mode
                        set state root
                    end
                case 'shuffle-artist' 'sa'
                    set allow_path yes
                    if test $previous = ipc-mode
                        set state ipc-path
                    end
                    if test $previous = option-mode
                        set state root
                    end
                end
            case option-path
                set state root
            case '*'
                set state none
        end
    end
    if test $state = root; and test $allow_path = no
        set state root-no-path
    end
    echo $state
end

